# InfluxDB 3 Core
# Create an admin token in InfluxDB 3 and set it here.
INFLUXDB_ADMIN_TOKEN=CHANGEME
INFLUXDB_DATABASE=unpoller

# Grafana
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=grafanaadmin

# UniFi Poller
POLLER_TAG=latest
POLLER_DEBUG=false
POLLER_SAVE_DPI=false
UNIFI_USER=unpoller
UNIFI_PASS=set_this_on_your_controller
UNIFI_URL=https://127.0.0.1:8443
